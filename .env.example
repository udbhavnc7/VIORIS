# ─── LLM ───
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Hosted free-tier fallbacks are OFF by default. Set to 1 only if you accept
# that, when Ollama fails, the planner request may leave the laptop.
VIORIS_LLM_FALLBACKS=0
# Optional free-tier providers (only used when VIORIS_LLM_FALLBACKS=1, in this
# order: Groq -> OpenRouter -> Gemini). An API key alone is NOT consent.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ─── Gmail (real account, opt-in) ───
# Create a Google Cloud OAuth client (Web application) and add this redirect URI:
#   http://127.0.0.1:8445/oauth/authorized
# Start the real connector with: python run_vioris.py --gmail
# Default is read-only. Write scopes are only requested when a caller explicitly
# passes {"include_write": true} to /v1/gmail/connect/start.
# Or write the same values to vioris_data/gmail_credentials.json as:
#   { "client_id": "...", "client_secret": "..." }
# VIORIS_GMAIL_CLIENT_ID=
# VIORIS_GMAIL_CLIENT_SECRET=

# ─── Local agents / knowledge (optional) ───
# VIORUS_BROWSER_URL=http://127.0.0.1:8431
# VIORUS_DOCUMENTS_URL=http://127.0.0.1:8432
# VIORUS_KNOWLEDGE_URL=http://127.0.0.1:8442

# ─── Voice ───
TTS_ENGINE=piper
STT_ENGINE=whisper_local
WAKE_WORD_ENGINE=openwakeword
WAKE_PHRASE=vioris
# openWakeWord pretrained model key ('hey_jarvis' ships built-in; a custom
# 'vioris' model can be trained/dropped in and referenced by name or path)
WAKE_WORD_MODEL=hey_jarvis
WAKE_THRESHOLD=0.5
CLAP_WAKE_ENABLED=true
CLAPS_REQUIRED=2
CLAP_WINDOW_SECONDS=2.5
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# TTS_MODEL=path/to/en_US-lessac-medium.onnx  (or place in models/)
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_MS=80
CAPTURE_TIMEOUT_SECONDS=10.0
STOP_LATENCY_MS=500
MODELS_DIR=models

# ─── Database ───
DATABASE_URL=postgresql://vioris:vioris_dev@localhost:5432/vioris
REDIS_URL=redis://localhost:6379/0

# ─── Gateway ───
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8420

# ─── Tailscale (Phase 5) ───
# TAILSCALE_LAPTOP_IP=100.x.x.x

# ─── Security ───
# JWT_SECRET=generate-a-random-secret-here
# DEVICE_PAIRING_TTL_SECONDS=300
