{
  "$description": "Vioris spacing, radii, motion, and component tokens. Source: docs/06-ui-design-system.md.",
  "spacing": {
    "0": { "$type": "dimension", "$value": "0rem" },
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" },
    "24": { "$type": "dimension", "$value": "6rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.375rem" },
    "md": { "$type": "dimension", "$value": "0.5rem" },
    "lg": { "$type": "dimension", "$value": "0.75rem" },
    "xl": { "$type": "dimension", "$value": "1rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "border": {
    "hairline": { "$type": "strokeWeight", "$value": 1 },
    "thick": { "$type": "strokeWeight", "$value": 2 }
  },
  "motion": {
    "instant": { "$type": "duration", "$value": "0ms" },
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "200ms" },
    "slow": { "$type": "duration", "$value": "350ms" },
    "easeOut": { "$type": "cubicBezier", "$value": [0.0, 0.0, 0.2, 1.0] },
    "reducedMotion": { "$type": "custom", "$value": "prefers-reduced-motion: reduce" }
  },
  "state": {
    "idle":      { "$type": "custom", "$value": { "tone": "cyan", "label": "Idle" } },
    "listening": { "$type": "custom", "$value": { "tone": "cyan", "label": "Listening" } },
    "thinking":  { "$type": "custom", "$value": { "tone": "violet", "label": "Thinking" } },
    "speaking":  { "$type": "custom", "$value": { "tone": "violet", "label": "Speaking" } },
    "error":     { "$type": "custom", "$value": { "tone": "danger", "label": "Error" } },
    "stopped":   { "$type": "custom", "$value": { "tone": "danger", "label": "Stopped" } }
  },
  "glass": {
    "panel": {
      "$type": "custom",
      "$value": {
        "background": "{color.surface.glass}",
        "blur": "24px",
        "borderColor": "{color.surface.border}",
        "borderRadius": "{radius.lg}"
      }
    }
  }
}